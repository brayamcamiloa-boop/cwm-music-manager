{
  "name": "cwm-music-manager",
  "version": "1.0.1",
  "private": true,
  "description": "Aplicación de escritorio para administrar productores y música",
  "author": "Camilo Ariza Velasco",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1 --open /website.html",
    "build": "vite build",
    "build:pages": "vite build --config vite.pages.config.js",
    "dist:win": "npm run build && electron-builder --win nsis",
    "start": "electron ."
  },
  "build": {
    "appId": "com.cwm.musicmanager",
    "productName": "CWM",
    "copyright": "Copyright © 2026 Camilo Ariza Velasco",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/downloads/**",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CWM Music Manager"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^45.3.0",
    "electron-builder": "^26.0.12",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  }
}
